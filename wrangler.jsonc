{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hub-business-supplies",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // La cuenta de Cloudflare donde vive todo esto. No es un secreto —es el
  // mismo identificador que sale en la URL del panel, del orden del
  // `database_id` de aquí abajo— y está escrito a propósito: sin él, wrangler
  // empieza preguntando a qué cuenta pertenece el token, y un token acotado a
  // lo suyo (D1, o sólo desplegar) no tiene permiso para leer esa lista y
  // falla antes de hacer nada. Le pasó al flujo que aplica las migraciones.
  "account_id": "95a7710834c8bff72bce596fa8ee852a",

  // Encendido: por ahora no hay un dominio propio conectado a Cloudflare (el
  // DNS de byslogistics.com.co se queda en GoDaddy), así que esta dirección
  // -- hub-business-supplies.<cuenta>.workers.dev -- es la entrada real.
  // La protección de Cloudflare Access se configura sobre el Worker mismo
  // (pestaña «Access» del Worker en el panel), no sobre un dominio, así que
  // cubre esta dirección igual que cubriría un dominio propio el día que
  // se conecte uno.
  "workers_dev": true,

  // La portada del hub y el cotizador ya construido. Cloudflare los sirve
  // directamente desde el borde; el Worker sólo se ejecuta para `/api/*`.
  "assets": {
    "directory": "./publico",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "BASE",
      "database_name": "bys-cotizaciones",
      "database_id": "5f1c9c97-8560-4318-b32f-e4eec568ea64",
      "migrations_dir": "migraciones"
    }
  ],

  "vars": {
    // Los dos datos de la aplicación en Cloudflare Access, tomados de la
    // pestaña «Access» del Worker en el panel de Cloudflare.
    // `ACCESO_DOMINIO` es el dominio del equipo (`algo.cloudflareaccess.com`)
    // y `ACCESO_AUD`, la etiqueta «Application Audience (AUD) Tag».
    "ACCESO_DOMINIO": "bold-tree-e82d.cloudflareaccess.com",
    "ACCESO_AUD": "50a1016b6040d48f71f0f5a5ceab41fb1665d3fe08fb2a17a6a784049ae666c5"
  },

  "observability": {
    "enabled": true
  }
}
